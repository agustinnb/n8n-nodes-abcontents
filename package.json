{
    "name": "n8n-nodes-abcontents",
    "version": "0.1.1",
    "description": "n8n nodes for ABContents: turn documents, websites or a short brief into narrated videos with captions and music, paid per video.",
    "license": "MIT",
    "homepage": "https://abcontents.com/api-access",
    "keywords": [
        "n8n-community-node-package",
        "video",
        "ai video",
        "text to video",
        "pdf to video",
        "abcontents"
    ],
    "author": {
        "name": "abcontents",
        "email": "hola@abcontents.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/agustinnb/n8n-nodes-abcontents.git"
    },
    "scripts": {
        "build": "n8n-node build",
        "build:watch": "tsc --watch",
        "dev": "n8n-node dev",
        "lint": "n8n-node lint",
        "lint:fix": "n8n-node lint --fix",
        "release": "n8n-node release",
        "prepublishOnly": "n8n-node prerelease"
    },
    "files": [
        "dist"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": true,
        "credentials": [
            "dist/credentials/AbContentsApi.credentials.js"
        ],
        "nodes": [
            "dist/nodes/AbContents/AbContents.node.js",
            "dist/nodes/AbContents/AbContentsTrigger.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "*",
        "eslint": "9.32.0",
        "prettier": "3.6.2",
        "release-it": "^21.1.0",
        "typescript": "5.9.2"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    }
}
